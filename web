<!DOCTYPE html>
<html>
<head>
    <title>My Food Restaurant</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>🍔 My Food Restaurant 🍕</h1>
        <p>Fresh Food | Best Taste | Good Service</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#menu">Menu</a>
        <a href="#offers">Offers</a>
        <a href="#contact">Contact</a>
    </nav>

    <section id="home">
        <h2>Welcome to My Food Restaurant</h2>
        <p>Enjoy delicious food with your family and friends.</p>
        <div class="sticker">🍕 🍔 🍟 🥤</div>
        <h3>Good Food, Good Mood!</h3>
    </section>

    <section id="menu">
        <h2>Our Food Menu</h2>

        <div class="food">
            <div class="sticker">🍔</div>
            <h3>Veg Burger</h3>
            <p>Price: ₹120</p>
            <button onclick="alert('Veg Burger selected!')">Order Now</button>
        </div>

        <div class="food">
            <div class="sticker">🍕</div>
            <h3>Veg Pizza</h3>
            <p>Price: ₹180</p>
            <button onclick="alert('Veg Pizza selected!')">Order Now</button>
        </div>

        <div class="food">
            <div class="sticker">🍜</div>
            <h3>Veg Noodles</h3>
            <p>Price: ₹100</p>
            <button onclick="alert('Veg Noodles selected!')">Order Now</button>
        </div>

        <div class="food">
            <div class="sticker">🍰</div>
            <h3>Chocolate Cake</h3>
            <p>Price: ₹90</p>
            <button onclick="alert('Chocolate Cake selected!')">Order Now</button>
        </div>

        <div class="food">
            <div class="sticker">🍦</div>
            <h3>Ice Cream</h3>
            <p>Price: ₹60</p>
            <button onclick="alert('Ice Cream selected!')">Order Now</button>
        </div>

        <div class="food">
            <div class="sticker">🥤</div>
            <h3>Fresh Juice</h3>
            <p>Price: ₹50</p>
            <button onclick="alert('Fresh Juice selected!')">Order Now</button>
        </div>

    </section>

    <section id="offers">
        <h2>🎉 Special Offers 🎉</h2>
        <p>Get 10% discount on your first order!</p>
        <p>Enjoy tasty food at affordable prices.</p>
        <div class="sticker">🎁 🍟 🎈</div>
    </section>

    <section id="reviews">
        <h2>Customer Reviews</h2>
        <p>⭐ Priya: Very tasty food and good service!</p>
        <p>⭐ Rahul: I loved the pizza. Good quality!</p>
        <p>⭐ Anu: Reasonable prices and quick delivery.</p>
    </section>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>📍 Address: Vijayawada, Andhra Pradesh</p>
        <p>📞 Phone: 9876543210</p>
        <p>✉ Email: myfood@gmail.com</p>
    </section>

    <footer>
        <p>Copyright © 2026 My Food Restaurant</p>
        <p>Thank you for visiting our website! ❤️</p>
    </footer>

</body>
</html>



body {
    background-color: #fff8ee;
    font-family: Arial;
    margin: 0;
    text-align: center;
}

header {
    background-color: #a84320;
    color: white;
    padding: 20px;
}

nav {
    background-color: #333;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
}

nav a:hover {
    color: orange;
}

section {
    padding: 25px;
}

h2 {
    color: brown;
}

.sticker {
    font-size: 65px;
    padding: 15px;
}

.food {
    display: inline-block;
    background-color: #fff0dc;
    width: 220px;
    margin: 15px;
    padding: 15px;
    border: 1px solid #e6c6a8;
    border-radius: 12px;
}

.food .sticker {
    font-size: 75px;
    background-color: white;
    border-radius: 10px;
}

.food h3 {
    color: #843c16;
}

.food p {
    font-size: 17px;
}

button {
    background-color: brown;
    color: white;
    border: none;
    padding: 10px 18px;
    cursor: pointer;
    border-radius: 5px;
}

button:hover {
    background-color: orange;
}

#offers {
    background-color: #ffe0b2;
}

#reviews {
    background-color: #fff1e6;
}

footer {
    background-color: brown;
    color: white;
    padding: 15px;
}

@media (max-width: 600px) {
    nav a {
        display: inline-block;
        margin: 8px;
    }

    .food {
        width: 80%;
    }
}
